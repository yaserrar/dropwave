# Let's Encrypt registration + expiry notices — must be a real address
EMAIL=

# Traefik dashboard. The certificate comes through the DNS challenge, so it works
# even without a DNS record; add one (proxied A record) only to open the dashboard.
TRAEFIK_HOST=traefik2.asrar.software
# Basic auth, output of: htpasswd -nB admin
# Keep the single quotes: the hash contains $ signs that compose would otherwise expand.
DASHBOARD_AUTH='admin:$2y$05$replace-with-your-hash'

# Cloudflare API token for the Let's Encrypt DNS challenge (custom token, zone
# asrar.software only: Zone/Read + DNS/Edit). The main server's token works too.
CF_DNS_API_TOKEN=

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_BIND=127.0.0.1
# App roles (created once by postgres/init on an empty volume)
DROPWAVE_DB_PASSWORD=
BACKUP_KEEP_DAYS=14

# ── pgAdmin ──────────────────────────────────────────────────────
# One level under asrar.software, so Cloudflare's free certificate covers it.
PGADMIN_HOST=pgadmin-ec2.asrar.software
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
