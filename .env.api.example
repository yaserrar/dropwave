# Copy to .env.api in ~/apps/dropwave on the server. Passed to the API container.

# "postgres" is the infra stack's container on the shared `data` network. The
# password is DROPWAVE_DB_PASSWORD from the infra .env (URL-encode special characters).
DATABASE_URL=postgresql://dropwave:change-me@postgres:5432/dropwave

AWS_REGION=eu-west-3
S3_BUCKET=dropwave

# Leave these out when the EC2 instance has an IAM role with access to the bucket
# (recommended; see DEPLOY.md). Only set them if you use access keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Links in emails point here: the share page is ${APP_URL}/s/<id>.
APP_URL=https://dropwave.asrar.software
# Sender of the share emails. Its domain must be verified in SES, in AWS_REGION,
# and the IAM role needs ses:SendEmail.
MAIL_FROM=Dropwave <noreply@asrar.software>

# Shared with the file-check Lambda, which signs its scan results with it.
# Generate with: openssl rand -hex 32
SCAN_RESULT_SECRET=