# Copy to .env.api in ~/apps/dropwave on the server. Passed to the API container.

# "postgres" is the infra stack's container name on the shared proxy network.
DATABASE_URL=postgresql://dropwave:change-me@postgres:5432/dropwave

AWS_REGION=eu-west-3
S3_BUCKET=dropwave

# Leave these out when the EC2 instance has an IAM role with access to the bucket
# (recommended; see DEPLOY.md). Only set them if you use access keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
