# Copy to .env in ~/apps/dropwave on the server. Read by docker compose itself
# (for ${...} in docker-compose.yml), not passed to the containers.

DOMAIN=dropwave.asrar.software
# GitHub user/org that owns the images on ghcr.io, lowercase.
IMAGE_OWNER=yaserrar
# Rewritten by the deploy workflow on every release (commit SHA).
IMAGE_TAG=latest
