// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileStatus {
  PENDING 
  EXPIRED
  SCANNING
  REMOVED
  DELETED
  UPLOADED 
}

enum ScanVerdict {
  CLEAN
  REJECTED
}

model File {
  id            String     @id @default(uuid()) // also the public share id in links
  key           String     @unique // S3 object key
  filename      String // original name, used for Content-Disposition on download
  contentType   String
  size          Int // bytes; BigInt so files over 2 GB fit
  status        FileStatus @default(PENDING)
  downloadCount Int        @default(0)
  expiresAt     DateTime?

  scanVerdict   ScanVerdict? // result of the file scan, if available
  scanReason    String?   // reason for the scan verdict, if available


  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt]) // find stale PENDING uploads to clean up
  @@index([expiresAt]) // find expired files to delete
  @@map("files")
}
